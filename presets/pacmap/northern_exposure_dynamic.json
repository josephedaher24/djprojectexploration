{
  "tracklists": [
    "music/northern-exposure/northern_exposure_tracks.csv"
  ],
  "energy_npz": "data/energy_embeddings/northern_exposure_energy_features.npz",
  "output_dir": "data/exports",
  "sequence_length": 10,
  "control_mode": "style-rhythm-harmony",
  "transition_scoring": {
    "style_weight": 0.5,
    "rhythm_weight": 0.3,
    "harmony_weight": 0.2,
    "rhythm_tempo_weight": 0.7
  },
  "n_neighbors": 10,
  "MN_ratio": 0.5,
  "FP_ratio": 1.5,
  "distance": "angular",
  "pair_source": "combined-all",
  "distance_combine": "l1",
  "layout_init": "neighbor",
  "layout_selection_mode": "interpolated",
  "step": 0.1,
  "static_layout": false,
  "random_state": 7777,
  "metadata_enrichment": {
    "enabled": true,
    "annotation_dir": "data/annotations",
    "genre_policy": "prefer_enriched",
    "key_policy": "prefer_enriched",
    "genre_min_score": 0.25,
    "key_min_confidence": 0.35
  },
  "ui": {
    "latent_links_per_track": 3,
    "recommended_links_highlight": 25,
    "point_color": "genre",
    "map_renderer": "webgl",
    "map_fx": true
  }
}
